# Relative logical destinations installed by dod/scripts/install.sh.
# The manifest deliberately excludes /etc/harw-dod/config.toml and all state,
# telemetry, and runtime files so upgrades/uninstall never remove operator data.
#
# The systemd/, sysusers/ and tmpfiles/ entries are installed from the one
# canonical deploy/ tree at the repository root (Crypto Masterplan v2 §22,
# H10). The harw-install parity test checks this list against the embedded
# deployment assets and dod/scripts/install.sh.
libexec/harw-sentinel
libexec/harw-probe-bpf
libexec/harw-probe-fs
libexec/harw-warden
bpf/exec.bpf.o
