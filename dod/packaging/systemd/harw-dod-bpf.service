[Unit]
Description=HARW DoD eBPF observation probe
PartOf=harw-dod.target
Requires=harw-dod-sentinel.service
After=harw-dod-sentinel.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=harw-dod-bpf
Group=harw-dod-bpf
SupplementaryGroups=harw-dod-ipc
ExecStart=@LIBEXECDIR@/harw-probe-bpf --config @SYSCONFDIR@/config.toml --sentinel-socket @RUNTIMEDIR@/sentinel.sock --exec-program-path @BPFDIR@/exec.bpf.o --exit-program-path @BPFDIR@/exit.bpf.o --tcp-v4-program-path @BPFDIR@/tcp_v4_connect.bpf.o --tcp-v6-program-path @BPFDIR@/tcp_v6_connect.bpf.o
Restart=on-failure
RestartSec=3s
NoNewPrivileges=yes
# The loader must verify both capabilities on the target kernel. Do not add
# CAP_SYS_ADMIN as a fallback and do not grant any file capability.
CapabilityBoundingSet=CAP_BPF CAP_PERFMON
AmbientCapabilities=CAP_BPF CAP_PERFMON
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=@BPFDIR@
ReadWritePaths=@RUNTIMEDIR@

[Install]
WantedBy=harw-dod.target
