[Unit]
Description=HARW DoD unprivileged sentinel
PartOf=harw-dod.target
After=local-fs.target
Before=harw-dod-bpf.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=harw-dod
Group=harw-dod
SupplementaryGroups=harw-dod-ipc
ExecStart=@LIBEXECDIR@/harw-sentinel --home @STATEDIR@ --socket @RUNTIMEDIR@/sentinel.sock --log info
Restart=on-failure
RestartSec=3s
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=@STATEDIR@ @LOGDIR@ @RUNTIMEDIR@

[Install]
WantedBy=harw-dod.target
