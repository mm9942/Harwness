[Unit]
Description=HARW DoD observation
Wants=harw-dod-sentinel.service harw-dod-bpf.service
After=harw-dod-sentinel.service harw-dod-bpf.service

# Deliberately no Warden or Warden socket dependency. Warden is installed for
# a later, explicitly enabled enforcement deployment and remains disabled.

[Install]
WantedBy=multi-user.target
