# Containerfile for the harw control binary (harw web / gateway entrypoint).
# Context: repo root (Harwness-dev/), build: podman build -t harw:local -f deploy/Containerfile .
# Source binary: target/release/harw (x86-64, dynamically linked, glibc).
# trixie: the release binary requires GLIBC >= 2.38 (bookworm ships 2.36).
FROM debian:trixie-slim

# Runtime deps: bubblewrap for harw's own sandboxed tool execution, ca-certificates
# for provider HTTPS, libdbus for the TUI/dbus path. Nothing else.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      bubblewrap \
      ca-certificates \
      libdbus-1-3 \
      iproute2 \
 && rm -rf /var/lib/apt/lists/*

# Non-root user mirroring the host layout: harw runs unprivileged everywhere.
RUN useradd --create-home --uid 1000 --user-group harw

COPY target/release/harw /usr/bin/harw
COPY deploy/systemd/harw-control.service /usr/share/doc/harw/deploy/systemd/harw-control.service
RUN chmod 0755 /usr/bin/harw && chown -R harw:harw /home/harw

USER harw
WORKDIR /home/harw

ENV HARW_HOME=/home/harw/.harw

# Control plane entrypoint: `harw web` binds its sockets inside the container.
# Ports are published by the Quadlet unit (deploy/quadlet/harw-control.container),
# not here — keep the image placement-agnostic.
EXPOSE 1337
ENTRYPOINT ["/usr/bin/harw"]
CMD ["web", "--systemd-socket"]
