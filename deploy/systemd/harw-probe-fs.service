# harw-probe-fs.service -- DoD fanotify probe, class CAP_SYS_ADMIN.
#
# Canonical source: deploy/systemd/ (Crypto Masterplan v2 §22, H10). Rendered
# by dod/scripts/install.sh (LIBEXECDIR).
#
# Installed, but NOT pulled in by harw-dod.target: --scope-root is mandatory
# and site-specific. Set it through a drop-in
# (/etc/systemd/system/harw-probe-fs.service.d/scope.conf: an empty
# `ExecStart=` line followed by the full command) and then
# `systemctl enable --now harw-probe-fs.service`.
#
# Landlock: hard start failure without full enforcement
# (harw-probe-fs/src/landlock.rs::enforce_read_scope). The binary connects to
# the sentinel socket FIRST and only then restricts itself.

[Unit]
Description=HARW DoD fanotify probe (push-only)
Documentation=man:harw-probe-fs(1)
PartOf=harw-dod.target
After=harw-sentinel.service
Wants=harw-sentinel.service
# Same reasoning as harw-probe-bpf.service: Wants=+After=, not Requires=.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=harw-probe-fs
Group=harw-probe-fs
SupplementaryGroups=harw-ipc
ExecStart=@LIBEXECDIR@/harw-probe-fs --log info --scope-root /srv/harw/watched --sentinel-socket /run/harw/sentinel.sock
# /srv/harw/watched is a placeholder; replace it via drop-in (see above).
Restart=on-failure
RestartSec=5

# -- Hardening --
NoNewPrivileges=yes
ProtectSystem=strict
# Observes (fanotify) and sends (Unix socket); never writes. The scope roots
# stay readable under "strict".
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=fanotify_init fanotify_mark landlock_create_ruleset landlock_add_rule landlock_restrict_self
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=CAP_SYS_ADMIN
AmbientCapabilities=CAP_SYS_ADMIN
# The only capability that permits fanotify_mark(FAN_MARK_FILESYSTEM) and the
# FAN_UNLIMITED_* flags this probe uses.

[Install]
WantedBy=harw-dod.target
