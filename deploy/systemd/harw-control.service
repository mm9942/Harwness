# harw-control.service -- HARW control plane (`harw web`, control.sock).
#
# Canonical source: deploy/systemd/ (Crypto Masterplan v2 §6.1, §22.2, H9,
# H10). Embedded into harw-install; `harw install --print-systemd
# harw-control.service` prints it.
#
# Socket-activated only: harw-control.socket hands over exactly one
# listening descriptor (LISTEN_FDS=1); `harw web --systemd-socket` implies
# system mode, takes it and fails hard otherwise (no fallback to binding a
# path, --socket/--socket-group are rejected). The socket unit owns path,
# mode 0660 and group harw-control-clients, so this service needs no write
# access to /run/harw/infra. No [Install] section; enable the socket (or
# harw-infra.target), never this service directly.
#
# `harw web` authorizes only its own UID (harw-cli/src/web.rs, SO_PEERCRED
# -> PermissionTier::Owner); other members of the socket group reach only
# GET /v1/health (403 unknown_peer elsewhere).
#
# AF_INET/AF_INET6: the control plane assembles the full runtime (sessions,
# agents, jobs) and reaches model providers over HTTPS.

[Unit]
Description=HARW control plane (harw web on /run/harw/infra/control.sock)
Documentation=man:harw(1)
Requires=harw-control.socket
After=harw-control.socket network-online.target
PartOf=harw-infra.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=harw-control
Group=harw-control
ExecStart=/usr/bin/harw --home /var/lib/harw-control web --systemd-socket
Sockets=harw-control.socket
StateDirectory=harw-control
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5

# -- Hardening --
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
# Not set: RestrictNamespaces=. Sandboxed tool execution (bubblewrap) needs
# unprivileged user/mount namespaces. Whether it also works under
# SystemCallFilter=@system-service is unverified on a real host (TODO(H9)).
