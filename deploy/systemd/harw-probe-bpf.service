# harw-probe-bpf.service -- DoD eBPF probe, class CAP_BPF + CAP_PERFMON.
#
# Canonical source: deploy/systemd/ (Crypto Masterplan v2 §22, H10). Rendered
# by harw-dod/scripts/install.sh (LIBEXECDIR, SYSCONFDIR, BPFDIR).
#
# Capability decision (H10): CAP_BPF alone is not enough. The real loader
# (harw-dod/crates/harw-dod-bpf/src/real.rs, has_attach_capabilities) refuses to
# attach unless BOTH CAP_BPF and CAP_PERFMON are effective: the programs are
# attached as sched tracepoints (perf_event_open) and FEntry/KProbe hooks,
# which the kernel gates on CAP_PERFMON since 5.8. No CAP_SYS_ADMIN fallback,
# no file capabilities.
#
# Landlock: hard start failure without full enforcement
# (harw-probe-bpf/src/landlock.rs). The binary connects to the sentinel
# socket FIRST and only then restricts itself.
#
# BPF object integrity (PL-100 Phase 4, THREAT-MODEL B23): before Landlock and
# before any load, every object is checked against the SHA-256 entries of
# @BPFDIR@/manifest.json (harw-probe-bpf/src/bpf_manifest.rs). The manifest and
# every directory above it must be root-owned and not group/world-writable
# (install.sh installs it 0644 root). A missing --bpf-manifest, an untrusted,
# unreadable or malformed manifest, a missing entry or a digest mismatch
# reports SensorDegraded and exits with status 78 (EX_CONFIG). So does a
# selected object that was removed after install or is empty, truncated or
# not ELF: it has no bytes to verify, and only degrading its sensor would
# leave this unit active but that detection lane blind. The manifest is read
# even when no object resolves. The refusal is permanent, so
# RestartPreventExitStatus=78 keeps Restart=on-failure from retrying it: the
# unit fails once and stays failed until an operator fixes the artifacts and
# restarts it. The development-only flag --dev-allow-missing-bpf (degrade
# instead of refusing; it requires --bpf-manifest and still verifies every
# object that resolves) is never set here.
#
# Rollout: manifests written before PL-100 Phase 4 are not valid TOML (the BTF
# digest line contained a newline), so this unit refuses to start with them.
# Rebuild and reinstall the BPF artifacts (`make -C harw-dod build-bpf`, then
# harw-dod/scripts/install.sh) before or together with the new binary and
# this unit.

[Unit]
Description=Harw-DoD eBPF observation probe (push-only)
Documentation=man:harw-probe-bpf(1)
PartOf=harw-dod.target
After=harw-sentinel.service
Wants=harw-sentinel.service
# Wants=+After=, deliberately not Requires=/BindsTo=: a sentinel restart must
# not take the probe down. The probe notices a vanished sentinel on its next
# send, exits, and Restart=on-failure brings it back.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=harw-probe-bpf
Group=harw-probe-bpf
SupplementaryGroups=harw-ipc harw-dod-config
ExecStart=@LIBEXECDIR@/harw-probe-bpf --log info --config @SYSCONFDIR@/config.toml --sentinel-socket /run/harw/sentinel.sock --exec-program-path @BPFDIR@/exec.bpf.o --exit-program-path @BPFDIR@/exit.bpf.o --tcp-v4-program-path @BPFDIR@/tcp_v4_connect.bpf.o --tcp-v6-program-path @BPFDIR@/tcp_v6_connect.bpf.o --bpf-manifest @BPFDIR@/manifest.json
Restart=on-failure
RestartSec=5
# 78 = EX_CONFIG: BPF object manifest refusal (see header), never retried.
RestartPreventExitStatus=78

# -- Hardening --
NoNewPrivileges=yes
ProtectSystem=strict
# Reads only the config, the BPF objects and their manifest, BTF and tracefs
# -- no writes. A connect() to the sentinel socket needs no writable mount.
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
# /sys/kernel/tracing and /sys/kernel/btf stay readable (read-only).
ProtectKernelLogs=yes
ProtectControlGroups=yes
# The profile resolves cgroup ids under /sys/fs/cgroup read-only.
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
# Push-only over one SOCK_SEQPACKET socket. Tracepoint/FEntry attachment
# uses bpf(2)/perf_event_open(2), not netlink.
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=bpf perf_event_open landlock_create_ruleset landlock_add_rule landlock_restrict_self
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=CAP_BPF CAP_PERFMON
AmbientCapabilities=CAP_BPF CAP_PERFMON

[Install]
WantedBy=harw-dod.target
