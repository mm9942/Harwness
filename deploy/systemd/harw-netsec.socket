# harw-netsec.socket -- activation socket of harw-netsec.service.
#
# Canonical source: deploy/systemd/ (Crypto Masterplan v2 §6, §22.2, §23, H10).
#
# AF_UNIX/SOCK_STREAM carrying Hyper HTTP/1; the daemon authenticates every
# peer via SO_PEERCRED. Exactly one Listen*= line, so the daemon receives
# LISTEN_FDS=1. /run/harw/infra/ is created by tmpfiles.d/harw.conf.

[Unit]
Description=HARW NetSec daemon activation socket
PartOf=harw-infra.target

[Socket]
ListenStream=/run/harw/infra/network.sock
SocketUser=harw-netsec
SocketGroup=harw-network
SocketMode=0660
# Only the daemon user and members of harw-network may connect.
Service=harw-netsec.service
RemoveOnStop=yes
Accept=no

[Install]
WantedBy=harw-infra.target
