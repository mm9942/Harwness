# harw-dod.target -- the DoD observation target.
#
# Canonical source: deploy/systemd/ (Crypto Masterplan v2 §22, H10). Embedded
# byte-identically into harw-install (`deployment::DEPLOYMENT_ASSETS`) and
# installed by harw-dod/scripts/install.sh. There is no second copy.
#
# Pulls up the observation units only: the unprivileged sentinel, the eBPF
# probe and the fanotify probe. Deliberately no edge to
# harw-warden.service/.socket (enforcement is a separate, explicit opt-in:
# `make -C harw-dod enable-warden`).
#
# PL-100 WP1.6: harw-probe-fs belongs to the target since its watch scope
# comes from /etc/harw-dod/config.toml ([probe_fs]) or its built-in defaults
# (the persistence locations of the persistence-write rule) instead of a
# placeholder --scope-root.

[Unit]
Description=Harw-DoD observation
Wants=harw-sentinel.service harw-probe-bpf.service harw-probe-fs.service
After=harw-sentinel.service harw-probe-bpf.service harw-probe-fs.service

[Install]
WantedBy=multi-user.target
