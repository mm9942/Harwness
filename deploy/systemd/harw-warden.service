# harw-warden.service -- DoD enforcement binary, socket-activated, no IP.
#
# Canonical source: deploy/systemd/ (Crypto Masterplan v2 §22, H10). Rendered
# by harw-dod/scripts/install.sh (LIBEXECDIR, SYSCONFDIR).
#
# Shipped DISABLED: no [Install] section, no edge from harw-dod.target, and
# the ConditionPathExists= guard below. Opt in with
# `make -C harw-dod enable-warden` (creates SYSCONFDIR/warden.enable).
#
# Identity (H10 reconciliation): a dedicated system user, never root. The
# earlier DoD-installer variant ran as root with an unrestricted bounding
# set; this unit keeps exactly the capabilities the code exercises:
#   CAP_DAC_OVERRIDE -- write cgroup.freeze/cgroup.kill below --cgroup-root.
#                       Those files are root-owned 0644 outside a delegated
#                       subtree; cgroup v2 checks plain file permissions for
#                       them, so DAC override (not CAP_SYS_ADMIN) is what a
#                       non-root warden needs. It also reads the root-owned
#                       0600 proof keys in proof_key_dir (PL-100 WP 3.1).
#                       Landlock (harw-warden/src/landlock.rs) confines all
#                       file access to --cgroup-root and the StateDirectory,
#                       marker files in the containment index (below), plus
#                       read/exec of nft when isolation is allowed.
#   CAP_NET_ADMIN    -- NOT granted by this unit. The default warden.toml
#                       allows freeze/thaw only. Network isolation runs
#                       /usr/sbin/nft as a child (harw-warden/src/
#                       isolation.rs, NftCommandBackend); nftables requires
#                       CAP_NET_ADMIN, inherited through the ambient set. The
#                       installer adds it with a drop-in only when
#                       warden.toml allows isolate-network/lift-isolation,
#                       harw-warden.service.d/isolation.conf:
#                         [Service]
#                         CapabilityBoundingSet=CAP_NET_ADMIN
#                         AmbientCapabilities=CAP_NET_ADMIN
#                       (both settings add to the lists below). Without it
#                       the warden refuses to start when isolation is
#                       allowed (NetAdminMissing), instead of failing at the
#                       first incident.
#   no CAP_KILL      -- kill-process-tree writes cgroup.kill; the kernel
#                       signals the cgroup's tasks itself (no kill(2)
#                       permission check), so the file permission above is
#                       the only gate.
#
# Landlock: hard start failure without full enforcement; the writable roots
# are --cgroup-root and the StateDirectory (nonce ledger, action ledger, hold
# timers, containment records; PL-100 WP 3.1, threat B24). In the
# containment index /run/harw-warden/holds the warden may only list, create
# and remove marker files (no symlinks, no directories).
#
# Containment markers (owner review 4505015305): every freeze creates an
# empty file /run/harw-warden/holds/<kernel id of the cgroup> before it
# writes cgroup.freeze; harw's job.resume never thaws a marked cgroup. At
# start, after Landlock and seccomp and before the first request, the warden
# reconciles markers with its records and the cgroups (stale markers of
# vanished or thawed cgroups go, a missing marker of a frozen one comes
# back, records from a previous boot are dropped). While running, the hold
# timer removes the markers of cgroups that vanished (e.g. after a kill) and
# retries markers a release could not remove. tmpfiles creates
# /run/harw-warden (root, 0755) and holds/ (harw-warden, 0755), also while
# the warden is disabled.
#
# seccomp (PL-100 decision O10): after Landlock the warden installs its own
# allowlist for all threads (harw-warden/src/seccomp.rs). Every call on it is
# in @system-service (the marker calls flock, unlinkat without AT_REMOVEDIR,
# getdents64 and geteuid included); the `seccomp` call itself is not, so it
# is allowed explicitly below. Process start (execve, ...), AF_NETLINK
# sockets and kill(SIGKILL) for an nft child that overruns its 10 s limit
# are on the warden's own list only when isolation is allowed.
#
# Keys: `harw-warden keygen --key-id <id>` (run as root, outside this unit)
# writes a new 0600 key into proof_key_dir; the warden loads keys at start,
# so restart it after adding or removing a key (rotation).

[Unit]
Description=Harw-DoD Warden -- enforcement at the systemd socket (disabled by default)
Documentation=man:harw-warden(1)
Requires=harw-warden.socket
After=harw-warden.socket
# Requires=+After=: harw-warden::systemd::acquire_listen_socket() requires
# exactly one inherited descriptor and aborts otherwise.
ConditionPathExists=@SYSCONFDIR@/warden.enable
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=harw-warden
Group=harw-warden
# Defaults of the binary: --policy /etc/harw-dod/warden.toml,
# --state-dir /var/lib/harw-warden (the StateDirectory below).
ExecStart=@LIBEXECDIR@/harw-warden --log info --cgroup-root /sys/fs/cgroup
Sockets=harw-warden.socket
Restart=on-failure
RestartSec=5

# -- State (PL-100 WP 3.1) --
# Nonce ledger (replay protection across restarts), hash-chained action
# ledger and persisted hold timers. systemd creates /var/lib/harw-warden
# owned by User=, mode 0700; WardenState::open refuses any group or world
# bit. Survives restarts and package updates (not removed on stop).
StateDirectory=harw-warden
StateDirectoryMode=0700

# -- Hardening --
NoNewPrivileges=yes
ProtectSystem=strict
# The writable roots: --cgroup-root and the StateDirectory, plus the
# containment index on its own line below. systemd already adds a
# StateDirectory= to the writable set under ProtectSystem=strict; it is
# listed again so the unit states every writable path in one place.
# /sys/fs/cgroup is explicit, although systemd keeps it writable under
# ProtectKernelTunables= unless ProtectControlGroups= is set.
ReadWritePaths=/sys/fs/cgroup /var/lib/harw-warden
# The containment index for harw (see the header). Deliberately NOT
# RuntimeDirectory=: systemd would remove the markers whenever this service
# stops, and job.resume could then lift a freeze the warden still holds.
# Without the "-" prefix: a missing directory (tmpfiles not run) fails the
# start, as the Landlock rule would.
ReadWritePaths=/run/harw-warden/holds
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
# Read-only /proc/sys is fine: the warden only reads
# /proc/sys/kernel/random/boot_id at startup. Do NOT add ProcSubset=pid: it
# hides that file, and without a boot id the warden discards every stored
# containment record at each start (fail closed; markers stay as orphans and
# hold timers no longer thaw).
ProtectKernelTunables=yes
ProtectKernelLogs=yes
# NOT ProtectControlGroups=yes: it would replace /sys/fs/cgroup with a
# read-only view and take away exactly the path this binary must write. The
# resulting failure would look like a Landlock error but be a unit error.
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
# No AF_INET/AF_INET6 ("no network in the warden"). AF_UNIX is the activation
# socket; AF_NETLINK is only for the nft child, which talks nftables over
# netlink. RestrictAddressFamilies= is inherited by that child.
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Landlock setup, then installing the warden's own seccomp filter (both
# before the first request; neither is allowed by that filter afterwards).
SystemCallFilter=landlock_create_ruleset landlock_add_rule landlock_restrict_self seccomp
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=CAP_DAC_OVERRIDE
AmbientCapabilities=CAP_DAC_OVERRIDE

# No [Install] section: activation only through harw-warden.socket, and only
# after the explicit opt-in above.
