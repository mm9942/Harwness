# harw-warden.socket -- activation socket of harw-warden.service.
#
# Canonical source: deploy/systemd/ (Crypto Masterplan v2 §22, H10). Rendered
# by dod/scripts/install.sh (SYSCONFDIR).
#
# Exactly ONE Listen*= line: harw-warden/src/systemd.rs::acquire_listen_socket()
# fails hard unless LISTEN_FDS == 1. A second socket would be a start error,
# not a harmless addition.
#
# Shipped DISABLED: no [Install] section and the same opt-in guard as the
# service. `make -C dod enable-warden` starts it explicitly.

[Unit]
Description=HARW DoD Warden activation socket (SOCK_SEQPACKET, disabled by default)
Documentation=man:harw-warden(1)
ConditionPathExists=@SYSCONFDIR@/warden.enable

[Socket]
ListenSequentialPacket=/run/harw/warden.sock
# SOCK_SEQPACKET, not a stream: harw-warden::ipc reads message-bounded
# frames and authenticates every peer via SO_PEERCRED.
SocketUser=harw-warden
SocketGroup=harw-warden-clients
SocketMode=0660
# Coarse OS-level pre-filter: only members of harw-warden-clients (empty by
# default; the operator adds the escalation client) may connect. It does not
# replace the SO_PEERCRED check in the binary. The probes are deliberately
# NOT members -- they are push-only towards the sentinel.
Service=harw-warden.service
RemoveOnStop=yes
Accept=no
# Accept=no: the one listening socket is handed to the single service
# process, which runs its own accept() loop (harw-warden::ipc::serve_forever).

# No [Install] section: never enabled by install, enable, or the target.
