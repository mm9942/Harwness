//! `harw-mia`: a personalized harw (harw <harw-version>) with the
//! user-interface agent user.agent.mia@1 1.0.0 as its fixed root, compiled by
//! `harw agent build --native`.
//!
//! It is a complete harw with its own, independent home `~/.mia`
//! (project-local: `.mia`); nothing is inherited from `~/.harw`.
//! The embedded agent is the fixed root.

#![forbid(unsafe_code)]

fn main() -> std::process::ExitCode {
    if let Err(error) = harw_agent_artifact::EmbeddedArtifact::verify_current_exe_matches(
        include_bytes!("../agent.harwa"),
    ) {
        eprintln!("agent integrity check failed: {error}");
        return std::process::ExitCode::FAILURE;
    }
    harw_cli::run_with_embedded_uia(
        include_bytes!("../agent.harwa"),
        harw_cli::HomeChoice::Named("mia"),
    )
}
