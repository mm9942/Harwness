# Generated by `harw agent build --native` (harw <harw-version>) for the
# user-interface agent user.agent.mia@1 1.0.0: a complete harw with this agent
# as its fixed root. Do not edit: every build rewrites this crate.

[package]
name = "harw-mia"
version = "1.0.0"
edition = "2024"
publish = false

[[bin]]
name = "harw-mia"
path = "src/main.rs"

[dependencies]
harw-agent-artifact = { path = "/opt/harw-src/harw-agent-artifact" }
# harw-cli with its default features: a normal harw.
harw-cli = { path = "/opt/harw-src/harw-cli" }

[profile.release]
lto = "thin"
codegen-units = 16

# A standalone crate, not a member of the harw workspace.
[workspace]
