+#[tokio::test]
+async fn owner_tier_reaches_the_gateway_over_the_daemon_socket() -> TestResult {
+    let d = start(|config, _| config.tier = harw_types::PermissionTier::Owner).await?;
+    let mut ws = upgrade_ws(&d.socket).await?;
+    // Wire minor 2 carries the R18 caps; the host masks them below it.
+    let hello = call(
+        &mut ws,
+        "1",
+        METHOD_SESSION_HELLO,
+        serde_json::json!({"client_label": "uds", "wire_minor": 2}),
+    )
+    .await?;
+    assert!(hello.error.is_none(), "{hello:?}");
+    let status = call(&mut ws, "2", METHOD_GATEWAY_STATUS, serde_json::json!({})).await?;
+    assert!(status.error.is_none(), "gateway.status for an owner: {status:?}");
+    Ok(())
+}
+
+#[tokio::test]
+async fn operator_tier_is_denied_the_gateway_over_the_daemon_socket() -> TestResult {
+    let d = start(|_, _| {}).await?;
+    let mut ws = upgrade_ws(&d.socket).await?;
+    let hello = call(
+        &mut ws,
+        "1",
+        METHOD_SESSION_HELLO,
+        serde_json::json!({"client_label": "uds", "wire_minor": 2}),
+    )
+    .await?;
+    assert!(hello.error.is_none(), "{hello:?}");
+    let status = call(&mut ws, "2", METHOD_GATEWAY_STATUS, serde_json::json!({})).await?;
+    assert!(status.error.is_some(), "an operator has no gateway_read: {status:?}");
+    Ok(())
+}
