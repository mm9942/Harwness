/TELEGRAM_TRANSPORT_PLAN.md
/project_handoff.md
/goal.md
/hardening-suggestive-inspiration.md

# Exportierte Claude-Code-Gespräche
/20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*.txt

# Build- und Prüfprotokolle aus lokalen Läufen (make build/clippy > …)
*.log

# Lokales Auslieferungsarchiv (zu gross fuer GitHub)
harw.zip
.harw/
harw-export-*

# lokale/experimentelle Räume, nicht Teil des Projekts
/spaces/

# Zu grosse Codex-Session-Transkripte (bleiben lokal in docs/sessions/, nie tracken)
/docs/sessions/codex-session-01a0afe0-*.md

# Temporäre Arbeitsdateien im Root
.tmp_*

# Never publish session transcripts, exports or local credentials
docs/sessions/
docs/archive/
**/*transcript*
# Source files that merely have "transcript" in their name (signing
# transcripts in harw-dod-encrypt) are code, not session transcripts.
!dod/crates/harw-dod-encrypt/src/transcript.rs
!dod/crates/harw-dod-encrypt/tests/transcript.rs
**/codex-session-*
auth.toml
*.key

# Python bytecode (scripts/tests)
__pycache__/

# Obsidian vault state (docs/planning is used as a vault; notes are versioned, UI state is not)
.obsidian/
