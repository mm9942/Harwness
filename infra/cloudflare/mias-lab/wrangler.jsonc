{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mias-lab",
  "main": "src/index.js",
  "compatibility_date": "2026-10-05",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MODEL_LANES",
        "class_name": "ModelLane"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ModelLane"]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    },
    "redact_query_string": true
  }
}
