<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RUN_USER_INITIATED_JOBS" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- Termux-Brücke (TermuxBridge): Befehle in Termux ausführen, nur nach Schalter und Freigabe. -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <queries>
        <package android:name="com.termux" />
    </queries>

    <application
        android:name=".HarwApplication"
        android:allowBackup="false"
        android:icon="@drawable/harw_mark"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:resizeableActivity="true"
        android:theme="@style/Theme.Harw"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
                Deep-Link für Benachrichtigungen (A9): harw://open?project=<id>&session=<id>.
                Bewusst OHNE BROWSABLE: Browser lösen den Filter nicht auf, nur explizite
                Intents der App selbst und Benachrichtigungs-PendingIntents.
                Die Activity muss die Parameter als unvertrauene Eingabe prüfen.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="harw" android:host="open" />
            </intent-filter>
            <!--
                Rückweg der Admin-Einrichtung (harw://profile?req=<id>&data=<base64url>): kommt aus dem
                Browser, deshalb BROWSABLE. Die App nimmt den Link nur an, wenn die Anfrage-ID zu einer
                offenen, höchstens 15 Minuten alten Anfrage dieses Telefons passt; sonst wird er verworfen.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="harw" android:host="profile" />
            </intent-filter>
        </activity>
        <activity
            android:name=".SessionWindowActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".HarwConnectionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the user-started authenticated Harw workspace connection open for live sessions and approvals." />
        </service>
        <service
            android:name=".ModelDownloadJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <service
            android:name=".ModelDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <receiver
            android:name=".ModelDownloadReceiver"
            android:exported="false" />
    </application>
</manifest>
