#!/usr/bin/env bash
# Spike S1 / verify V1 (standalone concept §6): cargo-check the in-process
# local host closure for aarch64-linux-android with the app's NDK and API level.
# 1) harw-local-host in the root workspace, 2) the mobile core with feature
# `local-host`. Extra arguments are passed to both cargo invocations.
set -euo pipefail
mobile_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
repo_root=$(cd -- "$mobile_root/.." && pwd -P)
ndk_version=28.2.13676358
export ANDROID_HOME="${ANDROID_HOME:-${ANDROID_SDK_ROOT:-$HOME/Android/Sdk}}"
export ANDROID_NDK_HOME="${ANDROID_NDK_HOME:-$ANDROID_HOME/ndk/$ndk_version}"
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$repo_root/target}"
export CARGO_PROFILE_DEV_DEBUG="${CARGO_PROFILE_DEV_DEBUG:-0}"
jobs="${MOBILE_BUILD_JOBS:-2}"
if [[ ! -f "$ANDROID_NDK_HOME/source.properties" ]]; then
    echo "Android NDK $ndk_version was not found at $ANDROID_NDK_HOME." >&2
    exit 1
fi
cd -- "$repo_root"
cargo ndk --target arm64-v8a --platform 28 check -p harw-local-host --lib --jobs "$jobs" "$@"
cd -- "$mobile_root/rust"
cargo ndk --target arm64-v8a --platform 28 check --lib --features local-host --jobs "$jobs" "$@"
echo "S1: harw-local-host and the mobile core (local-host) compile for aarch64-linux-android."
