#!/usr/bin/env bash
# Veroeffentlicht eine APK im Update-Dienst.
# Aufruf: harw-publish-update <apk> "<Release Notes>"   (Version wird aus der APK gelesen)
set -euo pipefail
ROOT="${HARW_UPD_ROOT:-$HOME/harw-updates}"
BASE="${HARW_UPD_BASE:-https://upd.harw.dev}"
APK="${1:?apk}"; NOTES="${2:-}"
CHANNEL="${HARW_UPD_CHANNEL:-stable}"
case "$CHANNEL" in
    stable) MANIFEST=latest.json; PREFIX=harw ;;
    beta) MANIFEST=latest-beta.json; PREFIX=harw-beta ;;
    *) echo "Unknown update channel: $CHANNEL" >&2; exit 2 ;;
esac
[ -f "$NOTES" ] && NOTES="$(cat "$NOTES")"
AAPT="$(ls "${ANDROID_HOME:-$HOME/Android/Sdk}"/build-tools/*/aapt2 2>/dev/null | sort -V | tail -1)"
[ -x "$AAPT" ] || { echo "aapt2 nicht gefunden"; exit 1; }
B="$("$AAPT" dump badging "$APK" | grep '^package:' || true)"
CODE="$(sed -E "s/.*versionCode='([0-9]+)'.*/\1/" <<<"$B")"
NAME="$(sed -E "s/.*versionName='([^']*)'.*/\1/" <<<"$B")"
[[ "$B" == "package: name='dev.harw.mobile' "* && "$CODE" =~ ^[1-9][0-9]*$ ]] ||
    { echo "Invalid Harw APK metadata" >&2; exit 1; }
SIGNER="${AAPT%/*}/apksigner"
"$SIGNER" verify "$APK"
if [[ "$CHANNEL" == beta && -f "$ROOT/latest.json" ]]; then
    python3 -I - "$ROOT" "$SIGNER" "$APK" <<'PY_SIGN'
import json, pathlib, re, subprocess, sys
from urllib.parse import urlsplit
root, signer, apk = sys.argv[1:]
root = pathlib.Path(root)
release = json.loads((root / "latest.json").read_text())
stable = root / "apk" / pathlib.Path(urlsplit(release["apkUrl"]).path).name
def certs(path):
    result = subprocess.run([signer, "verify", "--print-certs", str(path)], check=True, text=True, capture_output=True)
    return set(re.findall(r"certificate SHA-256 digest: ([a-fA-F0-9]{64})", result.stdout))
expected = certs(stable)
if len(expected) != 1 or certs(apk) != expected:
    sys.exit("Beta-APK muss denselben Signierer wie Stabil verwenden.")
PY_SIGN
fi
mkdir -p "$ROOT/apk"
exec 9>"$ROOT/.publish.lock"
flock 9
python3 -I - "$ROOT" "$MANIFEST" "$CODE" <<'PY_CHECK'
import json, pathlib, sys
root, manifest, code = sys.argv[1:]
target = pathlib.Path(root) / manifest
if target.exists() and int(code) <= json.loads(target.read_text())["versionCode"]:
    sys.exit("Versioncode muss im gewählten Update-Kanal steigen.")
stable = pathlib.Path(root) / "latest.json"
if manifest == "latest-beta.json" and stable.exists() and int(code) <= json.loads(stable.read_text())["versionCode"]:
    sys.exit("Beta-Versioncode muss höher als Stabil sein.")
PY_CHECK
FILE="$PREFIX-$CODE.apk"
cp "$APK" "$ROOT/apk/$FILE.tmp" && mv "$ROOT/apk/$FILE.tmp" "$ROOT/apk/$FILE"
python3 -I - "$ROOT" "$BASE" "$FILE" "$CODE" "$NAME" "$NOTES" "$CHANNEL" "$MANIFEST" <<'PY'
import hashlib, json, os, sys, time
root, base, file, code, name, notes, channel, manifest = sys.argv[1:]
p = os.path.join(root, "apk", file)
h = hashlib.sha256()
with open(p, "rb") as f:
    while c := f.read(1 << 20): h.update(c)
m = {"channel": channel, "versionCode": int(code), "versionName": name, "notes": notes,
     "apkUrl": f"{base}/apk/{file}", "sha256": h.hexdigest(),
     "size": os.path.getsize(p), "publishedAt": int(time.time())}
tmp = os.path.join(root, f"{manifest}.tmp")
with open(tmp, "w") as f: json.dump(m, f, ensure_ascii=False)
os.replace(tmp, os.path.join(root, manifest))
print(json.dumps(m, ensure_ascii=False, indent=1))
PY
# Push-Hinweis (FCM), falls ein Dienstkonto-Schluessel hinterlegt ist
HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
if [[ "$CHANNEL" == stable ]]; then
    python3 -I "$HERE/../update-service/fcm_send.py" "$CODE" "$NAME" || true
fi
